{
  "name": "aveon",
  "private": true,
  "scripts": {
    "dev:infra": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d --wait aveon-postgres aveon-redis",
    "dev:frontend": "pnpm --dir apps/frontend dev",
    "dev:backend": "dotnet watch run --project apps/backend",
    "dev": "pnpm dev:infra && concurrently \"pnpm dev:frontend\" \"pnpm dev:backend\""
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
