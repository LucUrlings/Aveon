{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient.FlightApiClient.LogicalHandler": "Warning",
      "System.Net.Http.HttpClient.FlightApiClient.ClientHandler": "Warning"
    }
  },
  "FlightApi": {
    "BaseUrl": "https://api.flightapi.io/",
    "ApiKey": "",
    "Currency": "EUR",
    "MaxConcurrentRequests": 5,
    "MaxRetryAttempts": 3,
    "MaxRetryDelaySeconds": 30,
    "MaxSchedulePages": 10
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "FlightApiOneWayTtlMinutes": 30,
    "AirportDataTtlMinutes": 10080,
    "ExploreRoutesTtlMinutes": 10080,
    "HeroRoutesTtlMinutes": 43200,
    "ExploreRoutesRetentionMinutes": 43200,
    "HeroRoutesRetentionMinutes": 129600,
    "SearchSessionTtlMinutes": 30
  },
  "AirportCatalog": {
    "RefreshEnabled": true,
    "SourceName": "mborsetti/airportsdata",
    "SourceUrl": "https://raw.githubusercontent.com/mborsetti/airportsdata/main/airportsdata/airports.csv",
    "RevisionApiUrl": "https://api.github.com/repos/mborsetti/airportsdata/commits?path=airportsdata%2Fairports.csv&per_page=1",
    "RevisionDownloadUrlTemplate": "https://raw.githubusercontent.com/mborsetti/airportsdata/{revision}/airportsdata/airports.csv",
    "RefreshAgeDays": 30,
    "CheckIntervalHours": 24,
    "DownloadTimeoutSeconds": 60,
    "MaximumDownloadBytes": 10485760,
    "MinimumAirportCount": 5000,
    "MaximumRowDropPercent": 10,
    "RequiredIataCodes": ["DUB", "AMS", "LHR", "CDG", "FRA", "JFK", "ATL", "DXB", "DOH", "SIN", "HND", "SYD"]
  },
  "Search": {
    "AnonymousMaxSearchCombinations": 75,
    "UserMaxSearchCombinations": 200,
    "ExecutionTimeoutMinutes": 10
  },
  "MultiDestinationSearch": {
    "Enabled": true,
    "SessionTtlMinutes": 30,
    "MaxOptimizedDestinations": 5,
    "MaxAirportsPerGroup": 5,
    "MaxTripDays": 31,
    "MaxOrderedLegs": 8,
    "AnonymousMaxProviderCalls": 25,
    "UserMaxProviderCalls": 100,
    "AdminMaxProviderCalls": 250,
    "HardMaxProviderCalls": 500,
    "MaxActiveStates": 10000,
    "MaxEvaluatedStates": 500000,
    "MaxCandidatesPerState": 25,
    "MaxStoredResults": 100,
    "ExecutionTimeoutMinutes": 10
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=aveon;Username=aveon;Password=aveon_dev_password"
  },
  "AllowedHosts": "*"
}
